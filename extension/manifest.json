{
  "manifest_version": 3,
  "name": "Verify with Gemini",
  "version": "1.7.1",
  "description": "Hover any image, verify it with Gemini using your own prompt.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "contextMenus",
    "clipboardWrite",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Verify with Gemini",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["*://gemini.google.com/*"],
      "js": ["content-overlay.js"],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": ["*://gemini.google.com/*"],
      "js": ["gemini-inject.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
